{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:runtime-protocol:registry:capability:knowledge.search:0.1.0:output",
  "title": "knowledge.search output",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "results": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "source": {
            "$ref": "urn:runtime-protocol:schemas:0.1:common#/$defs/resourceRef"
          },
          "title": {
            "type": "string",
            "maxLength": 500
          },
          "excerpt": {
            "type": "string",
            "minLength": 1,
            "maxLength": 20000
          },
          "score": {
            "type": "number"
          },
          "citation": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "uri": {
                "$ref": "urn:runtime-protocol:schemas:0.1:common#/$defs/uri"
              },
              "version": {
                "type": "string",
                "maxLength": 128
              },
              "location": {
                "type": "string",
                "maxLength": 256
              }
            }
          }
        },
        "required": ["source", "excerpt"]
      }
    }
  },
  "required": ["results"]
}
