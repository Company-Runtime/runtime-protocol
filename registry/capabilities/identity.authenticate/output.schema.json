{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:runtime-protocol:registry:capability:identity.authenticate:0.1.0:output",
  "title": "identity.authenticate output",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "authenticated": {
      "type": "boolean"
    },
    "subject": {
      "$ref": "urn:runtime-protocol:schemas:0.1:common#/$defs/identityRef"
    },
    "assertion": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "ref": {
          "$ref": "urn:runtime-protocol:schemas:0.1:common#/$defs/uri"
        },
        "expires_at": {
          "$ref": "urn:runtime-protocol:schemas:0.1:common#/$defs/timestamp"
        }
      },
      "required": ["ref"]
    }
  },
  "required": ["authenticated", "subject"]
}
