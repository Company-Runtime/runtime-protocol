{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:runtime-protocol:registry:capability:knowledge.validate:0.1.0:input",
  "title": "knowledge.validate input",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "item": {
      "$ref": "urn:runtime-protocol:schemas:0.1:common#/$defs/resourceRef"
    },
    "content": {
      "type": "string",
      "minLength": 1,
      "maxLength": 1000000
    },
    "rules": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,63}$"
          },
          "description": {
            "type": "string",
            "maxLength": 1000
          }
        },
        "required": ["id"]
      }
    }
  },
  "oneOf": [
    {
      "required": ["item"]
    },
    {
      "required": ["content"]
    }
  ]
}
