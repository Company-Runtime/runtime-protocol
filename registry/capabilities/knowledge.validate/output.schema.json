{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:runtime-protocol:registry:capability:knowledge.validate:0.1.0:output",
  "title": "knowledge.validate output",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "valid": {
      "type": "boolean"
    },
    "findings": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "rule": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,63}$"
          },
          "severity": {
            "enum": ["error", "warning", "info"]
          },
          "message": {
            "type": "string",
            "minLength": 1,
            "maxLength": 2000
          },
          "location": {
            "type": "string",
            "maxLength": 256
          }
        },
        "required": ["rule", "severity", "message"]
      }
    }
  },
  "required": ["valid", "findings"]
}
