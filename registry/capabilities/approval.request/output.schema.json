{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:runtime-protocol:registry:capability:approval.request:0.1.0:output",
  "title": "approval.request output",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "approval": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "ref": {
          "$ref": "urn:runtime-protocol:schemas:0.1:common#/$defs/resourceRef"
        },
        "status": {
          "const": "pending"
        },
        "requested_at": {
          "$ref": "urn:runtime-protocol:schemas:0.1:common#/$defs/timestamp"
        }
      },
      "required": ["ref", "status", "requested_at"]
    }
  },
  "required": ["approval"]
}
