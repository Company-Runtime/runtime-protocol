{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:runtime-protocol:registry:capability:resource.read:0.1.0:output",
  "title": "resource.read output",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "resource": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "ref": {
          "$ref": "urn:runtime-protocol:schemas:0.1:common#/$defs/resourceRef"
        },
        "type": {
          "type": "string",
          "maxLength": 64
        },
        "version": {
          "type": "string",
          "maxLength": 128
        },
        "updated_at": {
          "$ref": "urn:runtime-protocol:schemas:0.1:common#/$defs/timestamp"
        }
      },
      "required": ["ref"]
    },
    "content": {
      "type": ["string", "object", "array", "number", "boolean"]
    },
    "media_type": {
      "type": "string",
      "pattern": "^[a-z]+/[A-Za-z0-9.+-]+$"
    }
  },
  "required": ["resource", "content"]
}
