  "type": "object",
  "additionalProperties": false,
  "properties": {
    "work": {
      "$ref": "urn:runtime-protocol:schemas:0.1:common#/$defs/resourceRef"
    },
    "resolution": {
      "type": "string",
      "maxLength": 10000
    },
    "evidence": {
      "type": "array",
      "items": {
        "$ref": "urn:runtime-protocol:schemas:0.1:common#/$defs/evidenceRef"
      },
      "uniqueItems": true
