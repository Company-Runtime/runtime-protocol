{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:runtime-protocol:registry:capability:reasoning.classify:0.1.0:output",
  "title": "reasoning.classify output",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "labels": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,63}$"
          },
          "confidence": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          }
        },
        "required": ["id"]
      }
    },
    "results": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "index": {
            "type": "integer",
            "minimum": 0
          },
          "labels": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "id": {
                  "type": "string",
                  "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,63}$"
                },
                "confidence": {
                  "type": "number",
                  "minimum": 0,
                  "maximum": 1
                }
              },
              "required": ["id"]
            }
          }
        },
        "required": ["index", "labels"]
      }
    },
    "rationale": {
      "type": "string",
      "maxLength": 10000
    },
    "usage": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "input_units": {
          "type": "integer",
          "minimum": 0
        },
        "output_units": {
          "type": "integer",
          "minimum": 0
        },
        "unit": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_]{0,63}$"
        }
      },
      "required": ["unit"]
    }
  },
  "anyOf": [
    {
      "required": ["labels"]
    },
    {
      "required": ["results"]
    }
  ]
}
