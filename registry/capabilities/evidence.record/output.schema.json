{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:runtime-protocol:registry:capability:evidence.record:0.1.0:output",
  "title": "evidence.record output",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "evidence": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "ref": {
          "$ref": "urn:runtime-protocol:schemas:0.1:common#/$defs/evidenceRef"
        },
        "digest": {
          "$ref": "urn:runtime-protocol:schemas:0.1:common#/$defs/digest"
        },
        "recorded_at": {
          "$ref": "urn:runtime-protocol:schemas:0.1:common#/$defs/timestamp"
        }
      },
      "required": ["ref", "digest", "recorded_at"]
    }
  },
  "required": ["evidence"]
}
