{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:runtime-protocol:registry:capability:approval.decide:0.1.0:input",
  "title": "approval.decide input",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "approval": {
      "$ref": "urn:runtime-protocol:schemas:0.1:common#/$defs/resourceRef"
    },
    "decision": {
      "enum": ["approved", "rejected"]
    },
    "rationale": {
      "type": "string",
      "maxLength": 5000
    }
  },
  "required": ["approval", "decision"]
}
