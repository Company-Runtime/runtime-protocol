{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:runtime-protocol:registry:capability:approval.decide:0.1.0:output",
  "title": "approval.decide output",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "approval": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "ref": {
          "$ref": "urn:runtime-protocol:schemas:0.1:common#/$defs/resourceRef"
        }
      },
      "required": ["ref"]
    },
    "decision": {
      "enum": ["approved", "rejected"]
    },
    "decided_by": {
      "$ref": "urn:runtime-protocol:schemas:0.1:common#/$defs/identityRef"
    },
    "decided_at": {
      "$ref": "urn:runtime-protocol:schemas:0.1:common#/$defs/timestamp"
    }
  },
  "required": ["approval", "decision", "decided_by", "decided_at"]
}
