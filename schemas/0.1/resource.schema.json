{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:runtime-protocol:schemas:0.1:resource",
  "title": "Resource",
  "description": "Anything a capability acts upon, referenced by an absolute URI. See spec/0.1/requests.md.",
  "type": "object",
  "additionalProperties": false,
  "required": ["ref"],
  "properties": {
    "ref": { "$ref": "urn:runtime-protocol:schemas:0.1:common#/$defs/resourceRef" },
    "type": { "type": "string", "pattern": "^[a-z][a-z0-9_.-]{0,62}$" },
    "version": { "type": "string", "minLength": 1, "maxLength": 128 }
  }
}
