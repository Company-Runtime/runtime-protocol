{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:runtime-protocol:schemas:0.1:profile",
  "title": "Profile definition",
  "description": "A context that specializes capabilities without changing their intent. See spec/0.1/capabilities.md.",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "version", "status", "definition", "applies_to"],
  "properties": {
    "id": { "$ref": "urn:runtime-protocol:schemas:0.1:common#/$defs/vocabularyId" },
    "version": { "$ref": "urn:runtime-protocol:schemas:0.1:common#/$defs/semver" },
    "status": { "$ref": "urn:runtime-protocol:schemas:0.1:common#/$defs/status" },
    "definition": { "type": "string", "minLength": 10, "maxLength": 400 },
    "applies_to": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["capability"],
        "properties": {
          "capability": { "$ref": "urn:runtime-protocol:schemas:0.1:common#/$defs/capabilityId" },
          "input": { "$ref": "urn:runtime-protocol:schemas:0.1:common#/$defs/schemaSource" }
        }
      }
    },
    "excludes": {
      "type": "array",
      "items": { "type": "string", "minLength": 5, "maxLength": 300 }
    },
    "rfc": { "$ref": "urn:runtime-protocol:schemas:0.1:common#/$defs/rfc" }
  }
}
