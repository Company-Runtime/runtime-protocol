{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:runtime-protocol:schemas:0.1:credential-ref",
  "title": "CredentialRef",
  "description": "A reference to secret material held by a credential store; never the secret itself. See spec/0.1/providers.md.",
  "$ref": "#/$defs/credentialRef",
  "$defs": {
    "credentialRef": {
      "type": "object",
      "additionalProperties": false,
      "required": ["ref"],
      "properties": {
        "ref": { "$ref": "urn:runtime-protocol:schemas:0.1:common#/$defs/secretRef" },
        "owner": { "$ref": "urn:runtime-protocol:schemas:0.1:common#/$defs/credentialOwner" }
      }
    },
    "selector": {
      "description": "Credential selector in a request: a reference or an ownership class.",
      "type": "object",
      "additionalProperties": false,
      "minProperties": 1,
      "properties": {
        "ref": { "$ref": "urn:runtime-protocol:schemas:0.1:common#/$defs/secretRef" },
        "owner": { "$ref": "urn:runtime-protocol:schemas:0.1:common#/$defs/credentialOwner" }
      }
    },
    "binding": {
      "description": "Credential binding configured by an organization: which reference a provider may use.",
      "type": "object",
      "additionalProperties": false,
      "required": ["provider", "ref"],
      "properties": {
        "provider": { "$ref": "urn:runtime-protocol:schemas:0.1:common#/$defs/providerId" },
        "ref": { "$ref": "urn:runtime-protocol:schemas:0.1:common#/$defs/secretRef" }
      }
    }
  }
}
