{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:runtime-protocol:schemas:0.1:trait",
  "title": "Trait definition",
  "description": "An optional behaviour that composes with capabilities. See spec/0.1/capabilities.md.",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "version", "status", "definition"],
  "properties": {
    "id": { "$ref": "urn:runtime-protocol:schemas:0.1:common#/$defs/vocabularyId" },
    "version": { "$ref": "urn:runtime-protocol:schemas:0.1:common#/$defs/semver" },
    "status": { "$ref": "urn:runtime-protocol:schemas:0.1:common#/$defs/status" },
    "definition": { "type": "string", "minLength": 10, "maxLength": 400 },
    "enables_claims": { "$ref": "urn:runtime-protocol:schemas:0.1:common#/$defs/claimList" },
    "excludes": {
      "type": "array",
      "items": { "type": "string", "minLength": 5, "maxLength": 300 }
    },
    "rfc": { "$ref": "urn:runtime-protocol:schemas:0.1:common#/$defs/rfc" }
  }
}
