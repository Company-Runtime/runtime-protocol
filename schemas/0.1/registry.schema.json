{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:runtime-protocol:schemas:0.1:registry",
  "title": "Registry manifest",
  "description": "Top-level registry metadata and deprecated aliases. See spec/0.1/capabilities.md.",
  "type": "object",
  "additionalProperties": false,
  "required": ["protocol", "version", "aliases"],
  "properties": {
    "protocol": { "$ref": "urn:runtime-protocol:schemas:0.1:common#/$defs/protocol" },
    "version": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+$" },
    "description": { "type": "string", "maxLength": 1000 },
    "aliases": {
      "type": "array",
      "items": { "$ref": "#/$defs/alias" }
    }
  },
  "$defs": {
    "alias": {
      "type": "object",
      "additionalProperties": false,
      "required": ["alias", "canonical", "since"],
      "properties": {
        "alias": { "$ref": "urn:runtime-protocol:schemas:0.1:common#/$defs/capabilityId" },
        "canonical": { "$ref": "urn:runtime-protocol:schemas:0.1:common#/$defs/capabilityId" },
        "since": { "$ref": "urn:runtime-protocol:schemas:0.1:common#/$defs/semver" },
        "remove_after": { "$ref": "urn:runtime-protocol:schemas:0.1:common#/$defs/semver" }
      }
    }
  }
}
